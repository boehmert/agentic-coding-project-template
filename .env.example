# Copy this file to .env and fill in real values.
# The .env file is in .gitignore and will NOT be committed.

# --- Jira ---
# Base URL without context path suffix (e.g. /jira — added automatically by JiraClient)
JIRA_BASE_URL=https://your-jira-instance.example.com
JIRA_PAT=YOUR_JIRA_PAT_HERE
# Story points field ID varies by Jira instance.
# To find yours: GET /jira/rest/api/2/issue/PROJ-1?fields=*all and look for the field with point values.
JIRA_STORY_POINTS_FIELD=customfield_10016

# --- Confluence ---
CONFLUENCE_BASE_URL=https://your-confluence-instance.example.com
CONFLUENCE_PAT=YOUR_CONFLUENCE_PAT_HERE

# --- Bitbucket Server (optional) ---
BITBUCKET_BASE_URL=https://your-bitbucket-instance.example.com
BITBUCKET_PAT=YOUR_BITBUCKET_PAT_HERE
